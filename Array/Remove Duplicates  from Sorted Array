class Solution:
    def removeDuplicates(self, nums):
        seen = set()
        index = 0

        for num in nums:
            if num not in seen:
                seen.add(num)
                nums[index] = num
                index += 1
        return index


nums = [0,0,1,1,1,2,2,3,3,4]
sol = Solution()
k = sol.removeDuplicates(nums)
print("k =", k)
print("Array after removing duplicates:", nums[:k])
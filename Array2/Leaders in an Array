class Solution:
    def leaders(self, nums):
        ans = []

        for i in range(len(nums)):
            leader = True
            for j in range(i + 1, len(nums)):
                if nums[j] >= nums[i]:
                    leader = False
                    break
            if leader:
                ans.append(nums[i])
        return ans


nums = [1, 2, 5, 3, 1, 2]
finder = Solution()
ans = finder.leaders(nums)
print("Leaders in the array are: ", end="")
for leader in ans:
    print(leader, end=" ")
print()